PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/realtimecollab

# JWT
JWT_SECRET=<random-string-at-least-32-chars>

# Frontend URL (leave empty on Vercel, set to deployed backend URL)
CLIENT_URL=https://your-vercel-app.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=https://your-backend.com/api/auth/google/callback

# DeepSeek AI Review
DEEPSEEK_API_KEY=sk-...
